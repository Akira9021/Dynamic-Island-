# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Ваш числовой id в Telegram — узнать у @userinfobot. Офис слушается только вас.
OWNER_ID=

# Ключ Claude API: https://platform.claude.com → API keys
ANTHROPIC_API_KEY=

# Токены ботов из @BotFather — по одному на агента (см. agents.toml)
TOKEN_ALICE=
TOKEN_KEVIN=
TOKEN_LEO=
TOKEN_SAM=

# Необязательно: общий чат команды и чат-лента задач (узнать id: команда /id в чате)
OFFICE_CHAT_ID=
TASKS_CHAT_ID=

# Необязательно: модель и глубина размышлений (low / medium / high)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
